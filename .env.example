# ForgeComply 360 — Environment Configuration

# Server
PORT=3001
NODE_ENV=development

# Encryption key for credentials at rest (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-256-bit-hex-key-here

# AWS Security Hub
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Azure Defender
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# GitHub Dependabot
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Polling interval (minutes)
DEFAULT_POLL_INTERVAL=15
